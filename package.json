{
  "name": "pinterest.js",
  "version": "1.0.27",
  "description": "Get data from pinterest without any hassle.",
  "main": "dist/index.js",
  "repository": "https://github.com/TrishCX/Pinterest.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "docs": "typedoc --plugin typedoc-plugin-markdown --out markdown --entryPoints src/index.ts"
  },
  "keywords": [
    "pinterest",
    "image",
    "google",
    "api",
    "pinterest-api",
    "google-images",
    "search-images",
    "pinterest-image",
    "videos",
    "pins",
    "serp-api",
    "pinterest-json",
    "form",
    "json",
    "images",
    "google-serp",
    "wallpaper-anime",
    "wallpapers"
  ],
  "author": "rit3zh",
  "license": "MIT",
  "devDependencies": {
    "typedoc": "^0.27.3",
    "typedoc-plugin-markdown": "^4.3.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {},
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
